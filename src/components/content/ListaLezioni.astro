---
import { getCollection } from 'astro:content';
import { isLessonIn, lessonSlug } from '@/lib/lessons';
import { url } from '@/lib/url';

interface Props {
  /** Valore di `sezione` nel frontmatter delle lezioni, che è anche il primo segmento dell’indirizzo. */
  sezione: 'come-funziona' | 'storia';
}

const { sezione } = Astro.props;
const lezioni = (await getCollection('lezioni', (lezione) => isLessonIn(lezione, sezione))).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);
---

<ol class="mt-6 grid max-w-3xl gap-3">
  {lezioni.map((lezione) => (
    <li>
      <a
        href={url(`${sezione}/${lessonSlug(lezione)}/`)}
        class="block rounded-lg border border-border bg-surface p-4 text-text no-underline hover:border-accent"
      >
        <span class="font-semibold">{lezione.data.title}</span>
        <span class="block text-text-muted">{lezione.data.description}</span>
      </a>
    </li>
  ))}
</ol>
