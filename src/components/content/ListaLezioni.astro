---
import { getCollection } from 'astro:content';
import { isLessonIn, lessonSlug } from '@/lib/lessons';
import { url } from '@/lib/url';

interface Props {
  /** Valore di `sezione` nel frontmatter delle lezioni, che è anche il primo segmento dell’indirizzo. */
  sezione: 'come-funziona' | 'storia' | 'crittoanalisi';
}

const { sezione } = Astro.props;
const lezioni = (await getCollection('lezioni', (lezione) => isLessonIn(lezione, sezione))).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);
---

<ol class="tavola mt-8">
  {lezioni.map((lezione) => (
    <li>
      <a
        href={url(`${sezione}/${lessonSlug(lezione)}/`)}
        class="tavola-riga min-h-11 grid-cols-[2.25rem_1fr] sm:grid-cols-[2.5rem_1fr]"
      >
        <span class="tavola-numero pt-0.5" aria-hidden="true">
          {String(lezione.data.ordine).padStart(2, '0')}
        </span>
        <span>
          <span class="tavola-titolo">{lezione.data.title}</span>
          <span class="tavola-testo block">{lezione.data.description}</span>
        </span>
      </a>
    </li>
  ))}
</ol>
