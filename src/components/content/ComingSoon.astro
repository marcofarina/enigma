---
import { t } from '@/i18n';

interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="prose-it">
  <h1>{title}</h1>
  <p>{intro}</p>
  <p
    class="rounded-md border border-border bg-surface-muted px-4 py-3 font-sans text-base text-text-muted"
    role="status"
  >
    {t('status.comingSoon')}
  </p>
</section>
