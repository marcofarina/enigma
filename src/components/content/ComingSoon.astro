---
import { t } from '@/i18n';

interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="prose-it">
  <h1>{title}</h1>
  <p>{intro}</p>
  <p class="border-y border-print-red-soft py-2 font-mono text-[0.8125rem] leading-[1.5] text-ink-muted" role="status">
    {t('status.comingSoon')}
  </p>
</section>
