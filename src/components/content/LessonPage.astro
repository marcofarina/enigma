---
import type { CollectionEntry } from 'astro:content';
import { getEntries, render } from 'astro:content';
import DraftNotice from '@/components/content/DraftNotice.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { lessonSlug } from '@/lib/lessons';
import { url } from '@/lib/url';

/** Pagina di una lezione, con fonti e link alla precedente e alla successiva della stessa sezione. */
interface Props {
  lezione: CollectionEntry<'lezioni'>;
  previous?: CollectionEntry<'lezioni'> | undefined;
  next?: CollectionEntry<'lezioni'> | undefined;
}

const { lezione, previous, next } = Astro.props;
const { Content } = await render(lezione);
const fonti = await getEntries(lezione.data.fonti);
const link = (entry: CollectionEntry<'lezioni'>) => url(`${entry.data.sezione}/${lessonSlug(entry)}/`);
---

<BaseLayout title={lezione.data.title} description={lezione.data.description}>
  <article class="prose-it">
    {lezione.data.stato === 'bozza' && <DraftNotice />}
    <h1>{lezione.data.title}</h1>
    <Content />
    {fonti.length > 0 && (
      <section aria-labelledby="fonti-lezione" class="mt-12 border-t border-print-red-soft pt-4 font-sans text-base">
        <h2 id="fonti-lezione" class="!mt-0 !text-lg">
          {t('lesson.sources')}
        </h2>
        <ul class="text-ui text-ink-muted">
          {fonti.map(({ data }) => (
            <li>
              {data.autori}, {data.url ? <a href={data.url}>{data.titolo}</a> : <cite>{data.titolo}</cite>}
              {data.editore && `, ${data.editore}`}
              {data.anno && `, ${data.anno}`}.
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
  {(previous || next) && (
    <nav
      aria-label={t('lesson.nav')}
      class="no-print mt-10 flex max-w-[var(--content-width)] flex-wrap justify-between gap-x-8 gap-y-4 border-t-[1.5px] border-print-red pt-4"
    >
      {previous ? (
        <a href={link(previous)} class="block min-h-11 py-1 text-ink no-underline hover:[&_strong]:underline">
          <span class="block font-mono text-[0.8125rem] text-ink-muted">← {t('lesson.previous')}</span>
          <strong class="font-semibold decoration-print-red decoration-[1.5px] underline-offset-[0.2em]">
            {previous.data.title}
          </strong>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={link(next)} class="block min-h-11 py-1 text-right text-ink no-underline hover:[&_strong]:underline">
          <span class="block font-mono text-[0.8125rem] text-ink-muted">{t('lesson.next')} →</span>
          <strong class="font-semibold decoration-print-red decoration-[1.5px] underline-offset-[0.2em]">
            {next.data.title}
          </strong>
        </a>
      )}
    </nav>
  )}
</BaseLayout>
