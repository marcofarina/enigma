---
import { t } from '@/i18n';

interface Props {
  titolo: string;
  livello?: 'base' | 'avanzato';
}
const { titolo, livello = 'avanzato' } = Astro.props;
---

<details class="my-6 border-y border-print-red-soft py-3 font-sans text-base">
  <summary class="flex min-h-11 cursor-pointer items-center font-semibold">
    {titolo}
    {livello === 'avanzato' && (
      <span class="ms-2 font-mono text-[0.8125rem] font-normal text-ink-muted">· {t('lesson.advanced')}</span>
    )}
  </summary>
  <div class="mt-3 [&>p:last-child]:mb-0">
    <slot />
  </div>
</details>
