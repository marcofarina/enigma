---
import { t } from '@/i18n';

interface Props {
  titolo: string;
  livello?: 'base' | 'avanzato';
}
const { titolo, livello = 'avanzato' } = Astro.props;
---

<details class="my-6 rounded-lg border border-border bg-surface px-5 py-3 font-sans text-base">
  <summary class="cursor-pointer font-semibold">
    {titolo}
    {livello === 'avanzato' && <span class="ms-2 text-sm font-normal text-text-muted">· {t('lesson.advanced')}</span>}
  </summary>
  <div class="mt-3 [&>p:last-child]:mb-0">
    <slot />
  </div>
</details>
