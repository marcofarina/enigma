---
/**
 * Una risposta di `<Previsione>`. Nel corpo, facoltativo, il commento che lo studente legge se
 * l’ha scelta: per una risposta sbagliata, quale idea porta a darla.
 */
interface Props {
  /** Il testo della risposta: breve, perché è anche l’etichetta della scelta. */
  testo: string;
  corretta?: boolean;
}

const { testo, corretta = false } = Astro.props;
---

<div class="mt-2" data-risposta data-testo={testo} data-corretta={corretta ? '' : undefined}>
  {/* Nelle previsioni libere le scelte non si vedono: le risposte servono solo al confronto. */}
  <label class="flex min-h-11 cursor-pointer flex-wrap items-center gap-x-3 gap-y-1 rounded-md border border-border px-3 py-2 group-data-libera:hidden has-checked:border-accent has-disabled:cursor-default">
    <input type="radio" name="scelta" value={testo} class="size-4 accent-accent" />
    <span>{testo}</span>
    <span data-segno class="ms-auto text-sm font-semibold text-text-muted"></span>
  </label>
  <div data-commento data-testo={testo} hidden class="mt-3 text-text-muted [&>:last-child]:mb-0">
    <slot />
  </div>
</div>
