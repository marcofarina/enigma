---
/**
 * Tavola con titolo dello scheletro della lezione: la usano `Prerequisiti`, `Obiettivi` e
 * `Riepilogo`, non le lezioni. Il titolo è un `h2`, così chi usa un lettore di schermo trova le
 * tavole scorrendo i titoli della pagina. Obiettivi e riepilogo sono numerati, perché si leggono in
 * coppia: la voce 2 del riepilogo risponde alla voce 2 degli obiettivi.
 */
interface Props {
  /** Identificativo del titolo: ogni tavola compare al più una volta per lezione. */
  id: string;
  titolo: string;
  /** Il riepilogo chiude la lezione: più spazio sopra. */
  chiusura?: boolean;
  /** Voci numerate (obiettivi e riepilogo). */
  numerata?: boolean;
}

const { id, titolo, chiusura = false, numerata = false } = Astro.props;
---

<section
  aria-labelledby={id}
  class:list={['tavola-lezione', chiusura && 'tavola-chiusura', numerata && 'tavola-numerata']}
>
  <h2 id={id}>{titolo}</h2>
  <slot />
</section>
