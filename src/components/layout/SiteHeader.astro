---
import { t } from '@/i18n';
import { url } from '@/lib/url';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: url('simulatore/'), label: t('nav.simulator') },
  { href: url('come-funziona/'), label: t('nav.howItWorks') },
  { href: url('storia/'), label: t('nav.history') },
  { href: url('crittoanalisi/'), label: t('nav.cryptanalysis') },
  { href: url('esercizi/'), label: t('nav.exercises') },
  { href: url('docenti/'), label: t('nav.teachers') },
];

const currentPath = Astro.url.pathname;
---

<header class="no-print border-b border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <a href={url()} class="flex items-baseline gap-2 font-bold text-text no-underline">
      <span class="font-mono text-xl tracking-widest">ENIGMA</span>
      <span class="text-sm font-normal text-text-muted">{t('site.project')}</span>
    </a>
    <nav aria-label={t('nav.label')} class="flex-1">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-text no-underline hover:underline aria-[current=page]:font-semibold aria-[current=page]:text-accent"
              aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
