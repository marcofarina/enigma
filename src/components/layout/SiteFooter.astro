---
import { t } from '@/i18n';
import { url } from '@/lib/url';

const links = [
  { href: url('glossario/'), label: t('nav.glossary') },
  { href: url('schede/'), label: t('nav.sheets') },
  { href: url('fonti/'), label: t('nav.sources') },
];
---

<footer class="no-print mt-16 border-t border-border text-ui text-text-muted">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6">
    <ul class="flex flex-wrap gap-x-6 gap-y-1">
      {links.map((link) => (
        <li>
          <a href={link.href} class="inline-flex min-h-11 items-center text-text">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p>
      {t('footer.license.code')}; {t('footer.license.content')}. {t('footer.thirdParty')}
    </p>
  </div>
</footer>
