---
import '@/styles/global.css';
import '@/styles/print.css';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Head from '@/components/layout/Head.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import { t } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  /** Una classe per `<html>`: la pagina 3D scala la radice come la home. */
  htmlClass?: string;
  /** Il contenuto occupa tutta la larghezza, senza colonna né margini: la pagina disegna da sé la propria griglia. */
  largo?: boolean;
}

const { title, description, htmlClass, largo = false } = Astro.props;
---

<!doctype html>
<html lang="it" class={htmlClass}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body class="flex flex-col">
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2"
    >
      {t('a11y.skipToContent')}
    </a>
    <SiteHeader />
    <main id="contenuto" class={largo ? 'w-full flex-1' : 'mx-auto w-full max-w-6xl flex-1 px-4 py-8'}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
