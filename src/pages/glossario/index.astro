---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const voci = (await getCollection('glossario')).sort((a, b) =>
  a.data.termine.localeCompare(b.data.termine, 'it', { sensitivity: 'base' }),
);
const initial = (termine: string) => termine.normalize('NFD').charAt(0).toUpperCase();
const lettere = [...new Set(voci.map(({ data }) => initial(data.termine)))];
---

<BaseLayout title={t('glossary.title')} description={t('glossary.intro')}>
  <h1 class="page-title">{t('glossary.title')}</h1>
  <p class="page-lead">{t('glossary.intro')}</p>
  <nav aria-label={t('glossary.letters')} class="no-print mb-8">
    <ul class="flex max-w-[var(--content-width)] flex-wrap gap-2">
      {lettere.map((lettera) => (
        <li>
          <a href={`#lettera-${lettera}`} class="btn font-mono">
            {lettera}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {lettere.map((lettera) => (
    <section aria-labelledby={`lettera-${lettera}`} class="mb-8 max-w-[var(--content-width)]">
      <h2
        id={`lettera-${lettera}`}
        class="mb-3 scroll-mt-4 border-b-[1.5px] border-print-red pb-1 font-mono text-section font-bold text-print-red"
      >
        {lettera}
      </h2>
      <dl class="flex flex-col gap-5">
        {voci
          .filter(({ data }) => initial(data.termine) === lettera)
          .map(({ id, data }) => (
            <div id={id} class="scroll-mt-4">
              <dt class="text-lg font-semibold text-ink">{data.termine}</dt>
              <dd class="flex flex-col gap-1">
                {(data.tedesco || data.inglese) && (
                  <p class="font-mono text-[0.8125rem] leading-[1.5] text-ink-muted">
                    {data.tedesco && (
                      <span lang="de">
                        <abbr title={t('glossary.german')} class="font-bold no-underline">
                          DE
                        </abbr>{' '}
                        {data.tedesco}
                      </span>
                    )}
                    {data.tedesco && data.inglese && ' · '}
                    {data.inglese && (
                      <span lang="en">
                        <abbr title={t('glossary.english')} class="font-bold no-underline">
                          EN
                        </abbr>{' '}
                        {data.inglese}
                      </span>
                    )}
                  </p>
                )}
                <p>{data.definizione}</p>
                {data.vedi && (
                  <p class="text-ui">
                    <a href={url(data.vedi)}>{t('glossary.more')}</a>
                  </p>
                )}
              </dd>
            </div>
          ))}
      </dl>
    </section>
  ))}
</BaseLayout>
