---
import SolvedCount from '@/components/exercises/SolvedCount.tsx';
import { EXERCISES } from '@/exercises/catalog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const levels = [
  { level: 1, title: t('ex.level1') },
  { level: 2, title: t('ex.level2') },
  { level: 3, title: t('ex.level3') },
] as const;
---

<BaseLayout title={t('ex.title')}>
  <h1 class="page-title">{t('ex.title')}</h1>
  <p class="page-lead !mb-4">{t('ex.intro')}</p>
  <p class="mb-8 max-w-[var(--content-width)]">
    <a href={url('schede/')}>{t('ex.sheetsLink')}</a>
  </p>
  {levels.map(({ level, title }) => (
    <section aria-labelledby={`livello-${level}`} class="mb-10">
      <h2 id={`livello-${level}`} class="section-title !mt-10 !mb-3">
        {title}
      </h2>
      <ul class="tavola">
        {EXERCISES.filter((exercise) => exercise.level === level).map((exercise) => (
          <li class="tavola-riga relative sm:grid-cols-[1fr_auto]">
            <div class="flex flex-col gap-0.5">
              <a
                href={url(`esercizi/${exercise.id}/`)}
                class="tavola-titolo self-start after:absolute after:inset-0 after:content-['']"
              >
                {exercise.title}
              </a>
              <p class="tavola-testo mb-0">{exercise.summary}</p>
            </div>
            <SolvedCount client:only="react" exerciseId={exercise.id} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
