---
import ExerciseView from '@/components/exercises/ExerciseView.tsx';
import { EXERCISES, type Exercise } from '@/exercises/catalog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { url } from '@/lib/url';

export function getStaticPaths() {
  return EXERCISES.map((exercise) => ({ params: { id: exercise.id }, props: { exercise } }));
}

const { exercise } = Astro.props as { exercise: Exercise };
---

<BaseLayout title={exercise.title} description={exercise.summary}>
  <p class="mb-0">
    <a href={url('esercizi/')} class="back-link">
      ← {t('ex.back')}
    </a>
    <span class="text-ui text-ink-muted"> · {t(`ex.level${exercise.level}`)}</span>
  </p>
  <h1 class="page-title !mb-6">{exercise.title}</h1>
  <ExerciseView client:only="react" exerciseId={exercise.id}>
    <p slot="fallback" class="text-ink-muted">
      {t('ex.loading')}
    </p>
  </ExerciseView>
</BaseLayout>
