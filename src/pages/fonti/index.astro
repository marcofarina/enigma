---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, tf } from '@/i18n';
import { licenseLabel } from '@/lib/images';
import { modello3d } from '@/lib/modello3d';

const fonti = (await getCollection('fonti')).sort((a, b) => a.data.autori.localeCompare(b.data.autori, 'it'));
const immagini = await getCollection('immagini');
---

<BaseLayout title={t('sources.title')}>
  <section class="prose-it">
    <h1>{t('sources.title')}</h1>
    <h2>{t('sources.bibliography')}</h2>
    <ul>
      {fonti.map(({ data }) => (
        <li>
          {data.autori}, <cite>{data.url ? <a href={data.url}>{data.titolo}</a> : data.titolo}</cite>
          {data.editore && `, ${data.editore}`}
          {data.anno && `, ${data.anno}`}.{data.note && ` ${data.note}`}
        </li>
      ))}
    </ul>
    <h2>{t('sources.imageCredits')}</h2>
    {immagini.length === 0 ? (
      <p>{t('sources.noImages')}</p>
    ) : (
      <ul>
        {immagini.map(({ data }) => (
          <li>
            {data.titolo}: {data.attribuzione} (<a href={data.fonte}>{t('sources.source')}</a>,{' '}
            {data.urlLicenza ? <a href={data.urlLicenza}>{licenseLabel(data.licenza)}</a> : licenseLabel(data.licenza)}
            ).
          </li>
        ))}
      </ul>
    )}
    <h2 id="modello-3d">{t('sources.model3d')}</h2>
    <p>
      {tf('sources.model3dText', {
        license: licenseLabel(modello3d.licenza),
        font: modello3d.carattere.licenza,
      })}
    </p>
    <p>
      {t('sources.model3dExterior')}{' '}
      <cite>
        <a href={modello3d.esterno.url}>{modello3d.esterno.titolo}</a>
      </cite>
      {t('sources.model3dExteriorAuthor')} <a href={modello3d.esterno.urlAutore}>ASHISH</a>,
      {t('sources.model3dExteriorLicense')}
      <a href={modello3d.esterno.urlLicenza}>{licenseLabel(modello3d.esterno.licenza)}</a>.{' '}
      {t('sources.model3dExteriorChanges')}
    </p>
    <p>
      {t('sources.model3dLight')} <a href={modello3d.ambiente.url}>Poly Haven</a>, {t('sources.model3dLightLicense')}
    </p>
  </section>
</BaseLayout>
