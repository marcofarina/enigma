---
import SheetGenerator from '@/components/exercises/SheetGenerator.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('sheet.pageTitle')} description={t('sheet.intro')}>
  <div class="no-print">
    <h1 class="page-title">{t('sheet.pageTitle')}</h1>
    <p class="page-lead !mb-8">{t('sheet.intro')}</p>
  </div>
  <SheetGenerator client:only="react">
    <p slot="fallback" class="fallback-schermo text-ink-muted">
      {t('sheet.loading')}
    </p>
  </SheetGenerator>
</BaseLayout>
