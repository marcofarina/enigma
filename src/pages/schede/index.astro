---
import SheetGenerator from '@/components/exercises/SheetGenerator.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('sheet.pageTitle')} description={t('sheet.intro')}>
  <div class="no-print">
    <h1 class="mb-2 text-3xl font-bold">{t('sheet.pageTitle')}</h1>
    <p class="mb-8 max-w-3xl text-text-muted">{t('sheet.intro')}</p>
  </div>
  <SheetGenerator client:only="react">
    <p slot="fallback" class="text-text-muted">
      {t('sheet.loading')}
    </p>
  </SheetGenerator>
</BaseLayout>
