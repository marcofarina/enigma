---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import ListaLezioni from '@/components/content/ListaLezioni.astro';
import { url } from '@/lib/url';
---

<BaseLayout title={t('history.title')} description={t('history.intro')}>
  <section class="prose-it">
    <h1>{t('history.title')}</h1>
    <p>{t('history.intro')}</p>
  </section>
  <ListaLezioni sezione="storia" />
  <p class="mt-8 max-w-[var(--content-width)]">
    <a href={url('glossario/')}>{t('history.glossary')}</a>
  </p>
</BaseLayout>
