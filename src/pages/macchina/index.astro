---
import { getCollection, getEntries } from 'astro:content';
import '@/components/macchina/macchina.css';
import Macchina from '@/components/macchina/Macchina.tsx';
import type { Pezzo } from '@/components/macchina/pezzi';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { licenseLabel } from '@/lib/images';
import { isLessonIn, lessonSlug } from '@/lib/lessons';
import { modello3d } from '@/lib/modello3d';
import { pesoVista } from '@/lib/peso-vista';
import { url } from '@/lib/url';
import sorgentePezzi from '@/content/pezzi.yaml?raw';

/*
 * La macchina in 3D (fasi 5a e 5g di docs/piano.md, decisione D15; layout in docs/design.md,
 * «Pagina 3D»). Finché React non parte, e senza JavaScript, la pagina mostra l’anteprima resa da
 * Blender; three.js e il modello arrivano solo dopo «Avvia la vista 3D». Sopra la piega ci sono
 * solo la scena e il foglio; il resto della pagina sta sotto.
 *
 * Le schede dei pezzi (fase 5c) arrivano all’isola con la lezione e le fonti già risolte: una
 * lezione che non esiste ferma la build.
 */

const lezioni = await getCollection('lezioni', (l) =>
  ['come-funziona', 'storia', 'crittoanalisi'].some((sezione) => isLessonIn(l, sezione)),
);
const titoloDella = (percorso: string) => {
  const lezione = lezioni.find((l) => `${l.data.sezione}/${lessonSlug(l)}/` === percorso);
  if (!lezione) throw new Error(`pezzi.yaml: la lezione ${percorso} non esiste.`);
  return lezione.data.title;
};
// L’elenco segue l’ordine del file, che il caricatore della collezione non conserva.
const ordine = [...sorgentePezzi.matchAll(/^- id: (\S+)$/gm)].map((m) => m[1]);
const voci = (await getCollection('pezzi')).sort((a, b) => ordine.indexOf(a.id) - ordine.indexOf(b.id));
const pezzi: Pezzo[] = await Promise.all(
  voci.map(async ({ id, data }) => ({
    id,
    nome: data.nome,
    nodi: data.nodi,
    descrizione: data.descrizione,
    lezione: { href: url(data.lezione), titolo: titoloDella(data.lezione) },
    fonti: (await getEntries(data.fonti)).map(({ data: f }) => ({ autori: f.autori, titolo: f.titolo, url: f.url })),
  })),
);
---

<BaseLayout title={t('machine3d.title')} description={t('machine3d.description')} htmlClass="macchina-root" largo>
  <div class="macchina-banco machine machine-paint">
    <Macchina client:only="react" peso={pesoVista()} pezzi={pezzi}>
      <div slot="fallback" class="macchina">
        <div class="macchina-vano">
          <div class="macchina-palco machine">
            <img
              class="macchina-anteprima"
              src={modello3d.anteprima}
              width={modello3d.larghezzaAnteprima}
              height={modello3d.altezzaAnteprima}
              alt={t('machine3d.previewAlt')}
            />
          </div>
          <div class="macchina-piede">
            <noscript>
              <p class="macchina-gesti">{t('sim.noscript')}</p>
            </noscript>
          </div>
        </div>
        <div class="macchina-foglio macchina-foglio-segnaposto">
          <h1 class="macchina-titolo">{t('machine3d.title')}</h1>
        </div>
      </div>
    </Macchina>
  </div>

  <div class="macchina-sotto">
    <section class="macchina-come-si-usa">
      <h2>{t('machine3d.howTo')}</h2>
      <p>{t('machine3d.intro')}</p>
      <p>{t('machine3d.howToExplode')}</p>
    </section>

    <p class="macchina-crediti">
      {t('machine3d.credit')}{' '}
      <cite>
        <a href={modello3d.esterno.url}>{modello3d.esterno.titolo}</a>
      </cite>{' '}
      {t('machine3d.creditAuthor')} <a href={modello3d.esterno.urlAutore}>ASHISH</a> (
      <a href={modello3d.esterno.urlLicenza}>{licenseLabel(modello3d.esterno.licenza)}</a>).{' '}
      <a href={modello3d.crediti}>{t('machine3d.creditLink')}</a>
    </p>
  </div>
</BaseLayout>
