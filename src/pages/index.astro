---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const paths = [
  { href: url('simulatore/'), title: t('home.simulator.title'), text: t('home.simulator.text') },
  { href: url('come-funziona/'), title: t('home.howItWorks.title'), text: t('home.howItWorks.text') },
  { href: url('storia/'), title: t('home.history.title'), text: t('home.history.text') },
  { href: url('esercizi/'), title: t('home.exercises.title'), text: t('home.exercises.text') },
];
---

<BaseLayout>
  <section class="mb-12 max-w-3xl">
    <p class="mb-2 font-mono text-sm uppercase tracking-widest text-text-muted">{t('home.eyebrow')}</p>
    <h1 class="mb-4 text-4xl font-bold leading-tight sm:text-5xl">{t('home.title')}</h1>
    <p class="text-lg text-text-muted">{t('home.lead')}</p>
  </section>

  <ul class="grid gap-4 sm:grid-cols-2">
    {paths.map((path) => (
      <li>
        <a
          href={path.href}
          class="block h-full rounded-lg border border-border bg-surface p-5 text-text no-underline transition-colors hover:border-accent"
        >
          <h2 class="mb-2 text-xl font-semibold">{path.title}</h2>
          <p class="text-text-muted">{path.text}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
