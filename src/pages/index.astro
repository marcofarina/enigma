---
import '@/styles/global.css';
import '@/components/simulator/bench/bench.css';
import Head from '@/components/layout/Head.astro';
import Simulator from '@/components/simulator/Simulator.tsx';
import { t } from '@/i18n';
import { url } from '@/lib/url';

const nav = [
  { href: url('come-funziona/'), label: t('nav.howItWorks') },
  { href: url('storia/'), label: t('nav.history') },
  { href: url('crittoanalisi/'), label: t('nav.cryptanalysis') },
  { href: url('esercizi/'), label: t('nav.exercises') },
  { href: url('glossario/'), label: t('nav.glossary') },
];

/*
 * La home è il simulatore (docs/design.md): si apre il sito e la macchina è pronta a cifrare.
 * Niente intestazione né piè di pagina del sito: la barra del simulatore porta al percorso.
 */
---

<!doctype html>
<html lang="it" class="bench-root">
  <head>
    <Head description={t('site.description')} />
  </head>
  <body class="machine machine-paint">
    <Simulator client:only="react">
      {/* Finché la macchina non è pronta, e senza JavaScript, la barra porta comunque al percorso. */}
      <div slot="fallback" class="bench bench-fallback">
        <header class="bench-header">
          <a href={url()} class="bench-brand">
            {t('site.title')}
          </a>
          <nav aria-label={t('nav.label')} class="bench-nav">
            {nav.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        </header>
        <p class="bench-loading">{t('sim.loading')}</p>
      </div>
    </Simulator>
    <noscript>
      <style>
        .bench-loading {
          display: none;
        }
      </style>
      <p class="bench-noscript">{t('sim.noscript')}</p>
    </noscript>
  </body>
</html>
