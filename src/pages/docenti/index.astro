---
import { getCollection } from 'astro:content';
import LessonPage from '@/components/content/LessonPage.astro';
import { isLessonIn } from '@/lib/lessons';

const [guida] = await getCollection('lezioni', (lezione) => isLessonIn(lezione, 'docenti'));
if (!guida) throw new Error('Manca la guida per i docenti in src/content/lezioni/it/docenti/.');
---

<LessonPage lezione={guida} />
