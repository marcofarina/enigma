---
import Head from '@/components/layout/Head.astro';
import { t } from '@/i18n';
import { url } from '@/lib/url';

/*
 * Il simulatore ora è la home. Questa pagina resta per i link già distribuiti
 * (`/simulatore/?v=1&…`): rimanda alla home conservando query e frammento, così si apre la stessa
 * configurazione.
 */
const home = url();
---

<!doctype html>
<html lang="it">
  <head>
    <script is:inline define:vars={{ home }}>
      window.location.replace(home + window.location.search + window.location.hash);
    </script>
    <Head title={t('sim.title')} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
  </head>
  <body>
    <main>
      <h1>{t('sim.title')}</h1>
      <p>
        <a href={home}>{t('sim.moved')}</a>
      </p>
    </main>
  </body>
</html>
