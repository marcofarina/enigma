---
import Simulator from '@/components/simulator/Simulator.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('sim.title')}>
  <h1 class="mb-2 text-3xl font-bold">{t('sim.title')}</h1>
  <p class="mb-6 max-w-3xl text-text-muted">{t('sim.intro')}</p>
  <div data-simulator>
    <Simulator client:only="react">
      <p slot="fallback" class="text-text-muted">
        {t('sim.loading')}
      </p>
    </Simulator>
  </div>
  <noscript>
    <p class="rounded-md border border-border bg-surface-muted px-4 py-3">{t('sim.noscript')}</p>
  </noscript>
</BaseLayout>
